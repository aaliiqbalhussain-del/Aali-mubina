    "def get_grade(percent):\n",
    "    if percent >= 80:\n",
    "        return \"A\"\n",
    "    elif percent >= 70:\n",
    "        return \"B\"\n",
    "    elif percent >= 60:\n",
    "        return \"C\"\n",
    "    elif percent >= 50:\n",
    "        return \"D\"\n",
    "    return \"F\"\n",
    "\n",
    "for st in range(1, 6):\n",
    "    print(f\"Student {st}:\")\n",
    "    marks = []\n",
    "    failed = []\n",
    "    for sub in range(1, 5):\n",
    "        m = int(input(f\"Marks in subject {sub}: \"))\n",
    "        marks.append(m)\n",
    "        if m < 33:\n",
    "            print(f\"  Failed in Subject {sub}\")\n",
    "            failed.append(sub)\n",
    "    total = sum(marks)\n",
    "    percent = total / 4\n",
    "    if failed:\n",
    "        print(f\"Student {st}: {marks} -> Failed in Subject {', '.join(map(str, failed))}\\n\")\n",
    "    else:\n",
    "        print(f\"Student {st}: {marks} -> Total: {total}, Grade: {get_grade(percent)}\\n\")"
   ]
